---
import EvidenceBadge from "@/components/ui/EvidenceBadge.astro";
import PartGlyph from "@/components/ui/PartGlyph.astro";
import type { Formula } from "@/lib/formulas";
import type { Herb } from "@/lib/herbs";

type Props = { herb: Herb; formula: Formula; selected: boolean };
const { herb, formula, selected } = Astro.props;
---

<button
  class="herb-card"
  type="button"
  data-herb-card={herb.id}
  data-formula={formula.id}
  aria-current={selected}
  aria-controls={`ficha-${herb.id}`}
>
  <span class="herb-card__stage">
    <span class="herb-card__formula">{formula.name}</span>
    <span class="herb-card__glyph"><PartGlyph name={herb.partGlyph} size={88} /></span>
    <span class="herb-card__part">{herb.partUsed}</span>
  </span>
  <span class="herb-card__info">
    <span class="herb-card__name">{herb.name}</span>
    <em class="sci herb-card__sci">{herb.scientificName}</em>
    <EvidenceBadge level={herb.evidence.level} class="herb-card__evidence" />
  </span>
</button>

<style>
  .herb-card {
    all: unset;
    box-sizing: border-box;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    background: var(--surface-000);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    overflow: hidden;
    min-width: 0;
    transition:
      border-color 0.25s,
      transform 0.35s var(--ease),
      box-shadow 0.35s;
  }

  .herb-card[hidden] {
    display: none;
  }

  .herb-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 40px -28px rgb(10 30 15 / 0.45);
  }

  .herb-card[aria-current="true"] {
    border-color: var(--verde-selva);
    box-shadow: inset 0 0 0 1px var(--verde-selva);
  }

  .herb-card:focus-visible {
    outline: 2px solid var(--rojo-achiote);
    outline-offset: 3px;
  }

  .herb-card__stage {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 168px;
    background: var(--surface-200);
    position: relative;
    color: var(--verde-hoja);
  }

  .herb-card__formula,
  .herb-card__part {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .herb-card__formula {
    top: 14px;
    left: 16px;
  }

  .herb-card__part {
    bottom: 12px;
    right: 16px;
    max-width: calc(100% - 32px);
    text-align: right;
  }

  .herb-card__glyph {
    display: block;
    transition: transform 0.45s var(--ease);
  }

  .herb-card:hover .herb-card__glyph {
    transform: translateY(-6px) rotate(-4deg);
  }

  .herb-card__info {
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .herb-card__name {
    font-family: var(--font-display);
    font-size: 26px;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .herb-card__sci {
    color: var(--ink-muted);
    font-size: 15px;
  }

  .herb-card__info :global(.herb-card__evidence) {
    margin-top: 12px;
    align-self: flex-start;
  }

  /* En celular van de a dos: tarjetas compactas para que la ficha no quede lejos. */
  @media (max-width: 460px) {
    .herb-card__stage {
      height: 112px;
    }

    .herb-card__glyph :global(svg) {
      width: 60px;
      height: 60px;
    }

    .herb-card__formula {
      top: 10px;
      left: 12px;
      font-size: 10px;
    }

    .herb-card__part {
      display: none;
    }

    .herb-card__info {
      padding: 12px 12px 14px;
    }

    .herb-card__name {
      font-size: 20px;
    }

    .herb-card__sci {
      font-size: 13px;
    }

    .herb-card__info :global(.herb-card__evidence) {
      margin-top: 8px;
      white-space: normal;
      font-size: 10px;
      letter-spacing: 0.04em;
    }
  }
</style>
