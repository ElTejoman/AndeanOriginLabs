---
import Button from "@/components/ui/Button.astro";
import EvidenceBadge from "@/components/ui/EvidenceBadge.astro";
import FormulaPill from "@/components/ui/FormulaPill.astro";
import PartGlyph from "@/components/ui/PartGlyph.astro";
import StudyButton from "@/components/ui/StudyButton.astro";
import { PARTNERS_ANCHOR } from "@/data/site";
import { formatList } from "@/lib/format";
import type { Formula } from "@/lib/formulas";
import type { Herb } from "@/lib/herbs";

/**
 * Ficha de una planta: lo que dice la tradición, lo que muestran los estudios, los cuidados (si los hay)
 * y los estudios citados, enlazados.
 */
type Props = { herb: Herb; formula: Formula; active: boolean };
const { herb, formula, active } = Astro.props;

const partners = formatList(formula.herbs.filter((h) => h.id !== herb.id).map((h) => h.name.toLowerCase()));
const FACTS = [
  { term: "Parte usada", detail: herb.partUsed },
  { term: "Origen", detail: herb.origin },
  { term: "Abastecimiento", detail: herb.sourcing },
  { term: "Fórmula", detail: formula.name },
];
---

<article
  class="herb-detail"
  id={`ficha-${herb.id}`}
  data-herb-detail={herb.id}
  aria-labelledby={`ficha-${herb.id}-titulo`}
  hidden={!active}
>
  <div class="herb-detail__head">
    <div class="herb-detail__glyph" data-detail-part aria-hidden="true">
      <PartGlyph name={herb.partGlyph} size={104} />
    </div>
    <div>
      <div class="eyebrow">{herb.focus}</div>
      <h3 id={`ficha-${herb.id}-titulo`} tabindex="-1">{herb.name}</h3>
      <div class="herb-detail__sci">
        <em class="sci">{herb.scientificName}</em>
        {herb.otherNames && <span> · también {formatList(herb.otherNames)}</span>}
      </div>
      {herb.identityNote && <p class="herb-detail__note">{herb.identityNote}</p>}
    </div>
    <dl class="facts">
      {
        FACTS.map((fact) => (
          <div>
            <dt>{fact.term}</dt>
            <dd>{fact.detail}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="knowledge">
    <div class="knowledge__panel knowledge__panel--tradition" data-detail-part>
      <div class="eyebrow">Lo que dice la tradición</div>
      <h4>{herb.tradition.title}</h4>
      {herb.tradition.paragraphs.map((text) => <p>{text}</p>)}
    </div>
    <div class="knowledge__panel knowledge__panel--science" data-detail-part>
      <div class="eyebrow">Lo que muestran los estudios</div>
      <h4>{herb.science.title}</h4>
      {herb.science.paragraphs.map((text) => <p>{text}</p>)}
      <div class="knowledge__evidence">
        <EvidenceBadge level={herb.evidence.level} />
        <p>{herb.evidence.summary}</p>
      </div>
      {
        (herb.molecule || herb.compounds) && (
          <div class="knowledge__molecule">
            {herb.molecule && <FormulaPill formula={herb.molecule.formula} name={herb.molecule.name} />}
            {herb.compounds && <span>{herb.compounds.join(" · ")}</span>}
          </div>
        )
      }
    </div>
  </div>

  {
    herb.cautions && (
      <div class="cautions" data-detail-part>
        <div class="eyebrow">Cuidados</div>
        <ul>
          {herb.cautions.map((text) => (
            <li>{text}</li>
          ))}
        </ul>
      </div>
    )
  }

  <div class="studies" data-detail-part>
    <div class="eyebrow">Estudios citados</div>
    <ol>
      {
        herb.studies.map((study) => (
          <li>
            <div class="studies__text">
              <span class="studies__citation">{study.citation}</span>
              {study.title && <span class="studies__title">{study.title}</span>}
              <span class="studies__finding">{study.finding}</span>
            </div>
            <StudyButton url={study.url}>
              Ver estudio<span class="visually-hidden">: {study.citation}</span>
            </StudyButton>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="in-formula" data-detail-part>
    <div>
      <div class="eyebrow">En la fórmula {formula.name}</div>
      <p>Junto con {partners}. {formula.summary}</p>
    </div>
    <Button href={PARTNERS_ANCHOR} variant="green" arrow data-choose-formula={formula.id}>
      Solicitar {formula.name}
    </Button>
  </div>
</article>

<style>
  .herb-detail {
    margin-top: 16px;
    background: var(--surface-000);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    scroll-margin-top: var(--header-offset);
  }

  .herb-detail[hidden] {
    display: none;
  }

  .herb-detail__head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 32px;
    align-items: center;
    padding: 32px;
  }

  .herb-detail__glyph {
    color: var(--verde-hoja);
    padding: 12px;
  }

  h3 {
    font-size: clamp(38px, 5vw, 64px);
    line-height: 1;
    letter-spacing: -0.03em;
    font-weight: 300;
    margin-top: 12px;
  }

  h3:focus {
    outline: none;
  }

  .herb-detail__sci {
    font-size: 21px;
    color: var(--ink-muted);
    margin-top: 6px;
  }

  .herb-detail__note {
    margin-top: 10px;
    font-size: 14px;
    color: var(--ink-muted);
    max-width: 34em;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 15em));
    gap: 14px 28px;
    margin: 0;
    font-size: 14px;
  }

  .facts div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .facts dt {
    font-family: var(--font-mono);
    color: var(--ink-muted);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .facts dd {
    margin: 0;
    font-weight: 500;
  }

  .knowledge {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding: 0 12px 12px;
  }

  .knowledge__panel {
    --eyebrow-color: var(--panel-accent);
    padding: 32px;
    border-radius: 20px;
    min-width: 0;
  }

  .knowledge__panel--science {
    --panel-accent: var(--verde-hoja);
    background: var(--verde-tenue);
  }

  .knowledge__panel--tradition {
    --panel-accent: var(--rojo-achiote);
    background: var(--rojo-tenue);
  }

  h4 {
    font-size: 28px;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 14px 0;
    color: var(--panel-accent);
  }

  .knowledge__panel p + p {
    margin-top: 12px;
  }

  .knowledge__evidence {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .knowledge__evidence p {
    margin-top: 10px;
    font-size: 15px;
  }

  .knowledge__molecule {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--ink-muted);
  }

  .cautions {
    --eyebrow-color: var(--rojo-achiote);
    margin: 0 12px;
    padding: 28px 20px;
    border-bottom: 1px solid var(--line);
  }

  .cautions ul,
  .studies ol {
    margin: 14px 0 0;
    padding-left: 1.2em;
    display: grid;
    gap: 8px;
  }

  .cautions li {
    color: var(--ink-muted);
  }

  .studies {
    padding: 28px 32px;
  }

  .studies ol {
    gap: 18px;
  }

  /* El botón va a la derecha del estudio; si no cabe, baja debajo del texto. */
  .studies li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10px 24px;
    font-size: 15px;
  }

  .studies__text {
    flex: 1 1 22em;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .studies__citation {
    font-weight: 600;
    color: var(--verde-hoja);
  }

  .studies__title {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--ink);
  }

  .studies__finding {
    color: var(--ink-muted);
  }

  .in-formula {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 20px;
    align-items: center;
    padding: 24px 32px 28px;
    border-top: 1px solid var(--line);
  }

  .in-formula p {
    color: var(--ink-muted);
    margin-top: 8px;
    max-width: 50em;
  }

  @media (max-width: 820px) {
    .herb-detail__head {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 24px;
    }

    .herb-detail__glyph {
      display: none;
    }

    .knowledge {
      grid-template-columns: 1fr;
    }

    .knowledge__panel {
      padding: 24px;
    }

    .cautions {
      padding: 24px 12px;
    }

    .studies {
      padding: 24px;
    }

    .in-formula {
      grid-template-columns: 1fr;
      padding: 20px 24px 24px;
    }
  }
</style>
