---
import Button from "@/components/ui/Button.astro";
import FormulaPill from "@/components/ui/FormulaPill.astro";
import Jar from "@/components/ui/Jar.astro";
import { WAITLIST_ANCHOR } from "@/data/site";
import { formatRange } from "@/lib/format";
import { formatsLabel, regionLabel, type Herb } from "@/lib/herbs";

/** Ficha de una hierba: datos, lo que dice la ciencia, lo que dice la tradición y su uso en frasco. */
type Props = { herb: Herb; active: boolean };
const { herb, active } = Astro.props;

const FACTS = [
  { term: "Parte usada", detail: herb.partUsed },
  { term: "Altitud", detail: `${formatRange(herb.altitude.min, herb.altitude.max)} msnm` },
  { term: "Región", detail: regionLabel(herb.region) },
  { term: "Formato", detail: formatsLabel(herb) },
];
---

<article
  class="herb-detail"
  id={`ficha-${herb.id}`}
  data-herb-detail={herb.id}
  aria-labelledby={`ficha-${herb.id}-titulo`}
  hidden={!active}
>
  <div class="herb-detail__head">
    <div class="herb-detail__jar" data-detail-part aria-hidden="true">
      <Jar herb={herb} width={120} />
    </div>
    <div>
      <div class="eyebrow">{regionLabel(herb.region)} · {herb.regionDetail}</div>
      <h3 id={`ficha-${herb.id}-titulo`} tabindex="-1">{herb.name}</h3>
      <div class="herb-detail__sci"><em class="sci">{herb.scientificName}</em></div>
    </div>
    <dl class="facts">
      {
        FACTS.map((fact) => (
          <div>
            <dt>{fact.term}</dt>
            <dd>{fact.detail}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="knowledge">
    <div class="knowledge__panel knowledge__panel--science" data-detail-part>
      <div class="eyebrow">Lo que dice la ciencia</div>
      <h4>{herb.science.title}</h4>
      {herb.science.paragraphs.map((text) => <p>{text}</p>)}
      <div class="knowledge__molecule">
        <FormulaPill formula={herb.molecule.formula} name={herb.molecule.name} />
      </div>
      <p class="knowledge__sources">Fuente: {herb.science.sources}</p>
    </div>
    <div class="knowledge__panel knowledge__panel--tradition" data-detail-part>
      <div class="eyebrow">Lo que dice la tradición</div>
      <h4>{herb.tradition.title}</h4>
      {herb.tradition.paragraphs.map((text) => <p>{text}</p>)}
    </div>
  </div>

  <div class="in-jar" data-detail-part>
    <div>
      <div class="eyebrow">En tu frasco</div>
      <p>Tradicionalmente: <b>{herb.usage.traditional}</b>. Con nuestro extracto: {herb.usage.withExtract}</p>
    </div>
    <Button href={WAITLIST_ANCHOR} variant="green" arrow data-reserve={herb.id}>Reservar {herb.name}</Button>
  </div>
</article>

<style>
  .herb-detail {
    margin-top: 16px;
    background: var(--surface-000);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    scroll-margin-top: var(--header-offset);
  }

  .herb-detail[hidden] {
    display: none;
  }

  .herb-detail__head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 32px;
    align-items: center;
    padding: 32px;
  }

  h3 {
    font-size: clamp(38px, 5vw, 64px);
    line-height: 1;
    letter-spacing: -0.03em;
    font-weight: 300;
    margin-top: 12px;
  }

  h3:focus {
    outline: none;
  }

  .herb-detail__sci {
    font-size: 21px;
    color: var(--ink-muted);
    margin-top: 6px;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 14px 28px;
    margin: 0;
    font-size: 14px;
  }

  .facts div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .facts dt {
    font-family: var(--font-mono);
    color: var(--ink-muted);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .facts dd {
    margin: 0;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .knowledge {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding: 0 12px 12px;
  }

  .knowledge__panel {
    --eyebrow-color: var(--panel-accent);
    padding: 32px;
    border-radius: 20px;
    min-width: 0;
  }

  .knowledge__panel--science {
    --panel-accent: var(--verde-hoja);
    background: var(--verde-tenue);
  }

  .knowledge__panel--tradition {
    --panel-accent: var(--rojo-achiote);
    background: var(--rojo-tenue);
  }

  h4 {
    font-size: 28px;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 14px 0;
    color: var(--panel-accent);
  }

  .knowledge__panel p + p {
    margin-top: 12px;
  }

  .knowledge__molecule {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 20px;
  }

  .knowledge__sources {
    margin-top: 18px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-muted);
    font-family: var(--font-mono);
  }

  .in-jar {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 20px;
    align-items: center;
    padding: 24px 32px 28px;
  }

  .in-jar p {
    color: var(--ink-muted);
    margin-top: 8px;
    max-width: 50em;
  }

  .in-jar b {
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 820px) {
    .herb-detail__head {
      grid-template-columns: 1fr;
      padding: 24px;
    }

    .herb-detail__jar {
      display: none;
    }

    .knowledge {
      grid-template-columns: 1fr;
    }

    .knowledge__panel {
      padding: 24px;
    }

    .in-jar {
      grid-template-columns: 1fr;
      padding: 20px 24px 24px;
    }
  }
</style>
