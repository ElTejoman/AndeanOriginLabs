---
import CultureGlyph from "@/components/ui/CultureGlyph.astro";
import Section from "@/components/ui/Section.astro";
import { GLOSSARY } from "@/data/content";
---

<Section id="cultura" surface="grid-alt" aria-labelledby="cultura-titulo">
  <div class="wrap culture">
    <div>
      <div class="eyebrow" id="cultura-titulo">Cultura</div>
      <blockquote>
        Antes de “fitoterapia”, en el Ande se decía <em>hampi</em> y en la selva, <em>rao.</em>
      </blockquote>
      <p class="culture__note">
        Queremos que estas palabras se escuchen más allá de sus pueblos. Vienen del quechua, del shipibo-konibo y del
        awajún, y son parte de la marca porque son parte del Perú.
      </p>
    </div>
    <dl class="words" data-reveal>
      {
        GLOSSARY.map((entry) => (
          <div class="word">
            <dt>
              <b>{entry.word}</b>
              <small>{entry.origin}</small>
              <span class="word__glyph">
                <CultureGlyph name={entry.glyph} />
              </span>
            </dt>
            <dd>{entry.meaning}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</Section>

<style>
  .culture {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  blockquote {
    margin: 16px 0 0;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(34px, 4.4vw, 60px);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  blockquote em {
    color: var(--rojo-achiote);
  }

  .culture__note {
    color: var(--ink-muted);
    margin-top: 24px;
    max-width: 28em;
  }

  .words {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 0;
  }

  .word {
    container-type: inline-size;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: 24px;
    min-width: 0;
    background: var(--surface-000);
    transition:
      background 0.3s,
      color 0.3s;
  }

  .word:hover {
    background: var(--verde-selva);
    color: #fff;
  }

  .word dt {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 12px;
  }

  .word__glyph {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--verde-hoja);
    transition: color 0.3s;
  }

  .word:hover .word__glyph {
    color: #fff;
    --glyph-accent: var(--achiote-luz);
  }

  .word b {
    grid-column: 1;
    grid-row: 1;
    display: block;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 32px;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .word small {
    grid-column: 1;
    grid-row: 2;
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--rojo-achiote);
    margin-top: 10px;
  }

  .word dd {
    margin: 10px 0 0;
    color: var(--ink-muted);
    font-size: 15px;
    line-height: 1.5;
  }

  .word:hover small,
  .word:hover dd {
    color: rgb(255 255 255 / 0.8);
  }

  /* tarjeta angosta: el glifo pasa arriba para no encimarse con la palabra */
  @container (max-width: 200px) {
    .word dt {
      grid-template-columns: minmax(0, 1fr);
    }

    .word__glyph {
      grid-column: 1;
      grid-row: 1;
      margin-bottom: 14px;
    }

    .word b {
      grid-row: 2;
    }

    .word small {
      grid-row: 3;
    }
  }

  @media (max-width: 900px) {
    .culture {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 420px) {
    .words {
      grid-template-columns: 1fr;
    }
  }
</style>
