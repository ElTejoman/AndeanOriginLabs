---
import Section from "@/components/ui/Section.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import { SOURCING_PENDING, SOURCING_ZONES } from "@/data/content";
import { getHerb, type Herb } from "@/lib/herbs";
import { buildOriginProfile, VIEWBOX } from "@/lib/originProfile";

/** De dónde viene cada planta: las zonas de abastecimiento del dossier, de la Amazonía a los Andes. */
type Props = { herbs: Herb[] };
const { herbs } = Astro.props;

const places = SOURCING_ZONES.map((zone) => ({ ...zone, herbs: zone.herbs.map((id) => getHerb(herbs, id)) }));
const pending = SOURCING_PENDING.map((id) => getHerb(herbs, id));
const profile = buildOriginProfile(SOURCING_ZONES);
const plantCount = (count: number) => `${count} ${count === 1 ? "planta" : "plantas"}`;
---

<Section id="origen" surface="night">
  <div class="wrap">
    <SectionHeader eyebrow="Origen">
      De la Amazonía <em>a los Andes</em>
      <p slot="aside">
        Dónde se abastece cada planta de las fórmulas. Cada lote conserva su proveedor, su localidad y su fecha de cosecha.
      </p>
    </SectionHeader>

    <div class="profile">
      <svg
        viewBox={`0 0 ${VIEWBOX.width} ${VIEWBOX.height}`}
        role="img"
        aria-label={`Esquema de la Amazonía a los Andes con las zonas de abastecimiento: ${places.map((p) => p.place).join("; ")}`}
        data-origin-profile
      >
        <defs>
          <linearGradient id="terrain-fill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#8fd19b" stop-opacity=".28"></stop>
            <stop offset="1" stop-color="#8fd19b" stop-opacity="0"></stop>
          </linearGradient>
        </defs>

        <path class="terrain" d={profile.terrainPath}></path>
        <path class="ridge" d={profile.ridgePath} data-ridge data-reveal-self></path>

        {
          profile.regions.map((region) => (
            <text class="region" x={region.x} y={region.y} text-anchor="middle">
              {region.label}
            </text>
          ))
        }

        {
          profile.pins.map((pin) => (
            <g class="pin" data-pin data-reveal-self>
              <line class="pin__lead" x1={pin.x} x2={pin.x} y1={pin.labelY + 22} y2={pin.y - 10} />
              <text class="pin__name" x={pin.x} y={pin.labelY} text-anchor="middle">
                {pin.place}
              </text>
              <text class="pin__count" x={pin.x} y={pin.labelY + 16} text-anchor="middle">
                {plantCount(pin.count)}
              </text>
              <circle class="pin__halo" cx={pin.x} cy={pin.y} r="14" data-halo />
              <circle class="pin__dot" cx={pin.x} cy={pin.y} r="7" />
            </g>
          ))
        }
      </svg>
    </div>

    <ul class="places">
      {
        places.map((place) => (
          <li>
            <span class="places__status">{place.supplierPending ? "Proveedor por definir" : "Zona de abastecimiento"}</span>
            <b>{place.place}</b>
            <span class="places__herbs">
              {place.herbs.map((herb) => (
                <a href={`#ficha-${herb.id}`} data-select-herb={herb.id}>
                  {herb.name}
                </a>
              ))}
            </span>
          </li>
        ))
      }
      <li class="places__pending">
        <span class="places__status">Proveedor peruano</span>
        <b>Por definir</b>
        <span class="places__herbs">
          {
            pending.map((herb) => (
              <a href={`#ficha-${herb.id}`} data-select-herb={herb.id}>
                {herb.name}
              </a>
            ))
          }
        </span>
      </li>
    </ul>

    <p class="legend">Esquema ilustrativo, no a escala.</p>
  </div>
</Section>

<script>
  import { mustQs } from "@/scripts/core/dom";
  import { initOriginProfile } from "@/scripts/collection/initOriginProfile";

  initOriginProfile(mustQs<SVGSVGElement>("[data-origin-profile]"));
</script>

<style>
  .profile {
    overflow-x: auto;
    border: 1px solid var(--noche-line);
    border-radius: var(--r-lg);
    padding: 20px 8px 8px;
    background: rgb(255 255 255 / 0.02);
  }

  svg {
    display: block;
    min-width: 760px;
    width: 100%;
    height: auto;
  }

  .terrain {
    fill: url(#terrain-fill);
  }

  .ridge {
    fill: none;
    stroke: var(--hoja-luz);
    stroke-width: 2;
  }

  .region {
    fill: var(--on-noche-muted);
    font: 500 11px var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pin__lead {
    stroke: var(--on-noche-muted);
    stroke-width: 1;
    stroke-dasharray: 2 4;
    opacity: 0.7;
  }

  .pin__name {
    fill: var(--on-noche);
    font: 400 15px var(--font-display);
  }

  .pin__count {
    fill: var(--on-noche-muted);
    font: 400 11px var(--font-mono);
  }

  .pin__dot {
    fill: var(--hoja-luz);
    stroke: var(--noche);
    stroke-width: 3;
  }

  .pin__halo {
    fill: none;
    stroke: var(--hoja-luz);
    stroke-width: 1;
    opacity: 0.5;
  }

  .places {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  .places li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 20px;
    border: 1px solid var(--noche-line);
    border-radius: var(--r-card);
    min-width: 0;
  }

  .places__status {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-noche-muted);
  }

  .places b {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 22px;
  }

  .places__herbs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }

  .places__herbs a {
    padding: 6px 12px;
    border-radius: var(--r-pill);
    border: 1px solid var(--noche-line);
    color: var(--on-noche);
    font-size: 14px;
    text-decoration: none;
    transition:
      background 0.2s,
      color 0.2s;
  }

  .places__herbs a:hover {
    background: var(--hoja-luz);
    color: var(--noche);
  }

  .places__herbs a:focus-visible {
    outline: 2px solid var(--achiote-luz);
    outline-offset: 2px;
  }

  .places__pending {
    border-style: dashed !important;
  }

  .legend {
    margin-top: 18px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--on-noche-muted);
  }

  @media (max-width: 900px) {
    .places {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .places {
      grid-template-columns: 1fr;
    }
  }
</style>
