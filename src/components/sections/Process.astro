---
import Section from "@/components/ui/Section.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import { KNOWLEDGE_LABELS, PROCESS_STEPS } from "@/data/content";

const pad = (n: number) => String(n).padStart(2, "0");
---

<Section id="proceso">
  <div class="wrap">
    <SectionHeader eyebrow="De la chacra al frasco">
      Cómo hacemos <em>un extracto</em>
      <p slot="aside">Cuatro pasos donde la tradición y el laboratorio trabajan juntos.</p>
    </SectionHeader>

    <div class="steps" data-process>
      <div class="steps__rail" aria-hidden="true"><i data-rail-fill></i></div>
      <ol class="steps__list">
        {
          PROCESS_STEPS.map((step, i) => (
            <li class="step" data-step data-reveal-self>
              <span class="step__n">PASO {pad(i + 1)}</span>
              <h3>{step.title}</h3>
              <p set:html={step.html} />
              <span class:list={["step__tag", `step__tag--${step.knowledge}`]}>{KNOWLEDGE_LABELS[step.knowledge]}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</Section>

<script>
  import { mustQs } from "@/scripts/core/dom";
  import { initProcessRail } from "@/scripts/motion/processRail";

  initProcessRail(mustQs("[data-process]"));
</script>

<style>
  .steps {
    position: relative;
    padding-top: 40px;
  }

  .steps__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps__rail {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--line);
    overflow: hidden;
    border-radius: 2px;
  }

  .steps__rail i {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--verde-selva), var(--rojo-achiote));
    transform-origin: left;
  }

  .step {
    min-width: 0;
    position: relative;
  }

  .step::before {
    content: "";
    position: absolute;
    top: -46px;
    left: 0;
    width: 12px;
    height: 12px;
    border-radius: var(--leaf);
    background: var(--surface-100);
    border: 2px solid var(--verde-selva);
  }

  .step__n {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-muted);
  }

  .step h3 {
    font-size: 24px;
    line-height: 1.15;
    margin-top: 12px;
    letter-spacing: -0.01em;
  }

  .step p {
    color: var(--ink-muted);
    margin-top: 10px;
    font-size: 16px;
  }

  .step__tag {
    display: inline-block;
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: var(--r-pill);
  }

  .step__tag--ciencia {
    background: var(--verde-tenue);
    color: var(--verde-hoja);
  }

  .step__tag--tradicion {
    background: var(--rojo-tenue);
    color: var(--rojo-achiote);
  }

  .step__tag--ambos {
    background: var(--surface-200);
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .steps {
      padding-top: 0;
    }

    .steps__list {
      grid-template-columns: 1fr 1fr;
      row-gap: 56px;
    }

    .steps__rail,
    .step::before {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .steps__list {
      grid-template-columns: 1fr;
      row-gap: 40px;
    }
  }
</style>
