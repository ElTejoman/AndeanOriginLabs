---
import EvidenceBadge from "@/components/ui/EvidenceBadge.astro";
import Section from "@/components/ui/Section.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import { EVIDENCE_GUIDE } from "@/data/content";

/** Qué aporta cada tipo de estudio. Las etiquetas de las fichas usan los mismos colores. */
---

<Section id="evidencia" surface="grid" aria-labelledby="evidencia-titulo">
  <div class="wrap">
    <SectionHeader eyebrow="Antes de leer las fichas" headingId="evidencia-titulo">
      Cómo leer <em>la evidencia</em>
      <p slot="aside">
        Cada tipo de estudio aporta algo distinto. En cada ficha indicamos de dónde viene la evidencia de esa planta.
      </p>
    </SectionHeader>

    <ul class="guide" data-reveal>
      {
        EVIDENCE_GUIDE.map((row) => (
          <li class="guide__item">
            <EvidenceBadge level={row.level} label={row.title} />
            <dl>
              <dt>Qué aporta</dt>
              <dd>{row.contribution}</dd>
            </dl>
          </li>
        ))
      }
    </ul>

    <p class="guide__note">Cada estudio citado enlaza a su fuente original.</p>
  </div>
</Section>

<style>
  .guide {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guide__item {
    padding: 24px;
    background: var(--surface-000);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    min-width: 0;
  }

  dl {
    margin: 20px 0 0;
  }

  dt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  dd {
    margin: 6px 0 0;
    font-size: 15px;
  }

  .guide__note {
    margin-top: 24px;
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.3;
    max-width: 34em;
  }

  @media (max-width: 1000px) {
    .guide {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .guide {
      grid-template-columns: 1fr;
    }
  }
</style>
