---
import Button from "@/components/ui/Button.astro";
import type { Herb } from "@/lib/herbs";

type Props = { herbs: Herb[] };
const { herbs } = Astro.props;

const webhookUrl = import.meta.env.PUBLIC_WAITLIST_WEBHOOK_URL ?? "";
---

<section class="waitlist night night-grid" id="lista" aria-labelledby="lista-titulo">
  <div class="waitlist__orb" aria-hidden="true"></div>
  <div class="wrap waitlist__inner">
    <div>
      <div class="eyebrow">Preventa</div>
      <h2 id="lista-titulo">Reserva tu <em>primer frasco</em></h2>
      <p class="waitlist__lead">
        Inscríbete en la lista de espera, elige tu hierba y te avisamos antes que a nadie cuando salga, con precio especial
        de preventa. Reservar no tiene costo ni compromiso.
      </p>
    </div>

    <form class="waitlist-form" novalidate data-waitlist data-webhook={webhookUrl}>
      <label>
        Nombre
        <input name="nombre" autocomplete="given-name" placeholder="Rosa" required />
      </label>
      <label>
        Correo
        <input name="correo" type="email" autocomplete="email" placeholder="rosa@correo.pe" required />
      </label>
      <label>
        Frasco que quieres reservar
        <select name="hierba">
          <option value="">Todavía no sé</option>
          {herbs.map((herb) => <option value={herb.id}>{herb.name}</option>)}
        </select>
      </label>
      <!-- Trampa anti-spam: invisible para las personas, los bots suelen llenarla. -->
      <label class="waitlist-form__trap" aria-hidden="true">
        Empresa
        <input name="empresa" tabindex="-1" autocomplete="off" />
      </label>
      <Button type="submit" arrow>Reservar mi frasco</Button>
      {
        !webhookUrl && (
          <p class="waitlist-form__hint">Versión de muestra: el formulario aún no está conectado a un servicio de correo.</p>
        )
      }
      <p class="waitlist-form__status" data-status role="status" hidden></p>
    </form>
  </div>
</section>

<script>
  import { mustQs } from "@/scripts/core/dom";
  import { initWaitlist } from "@/scripts/waitlist/initWaitlist";

  const form = mustQs<HTMLFormElement>("[data-waitlist]");
  initWaitlist(form, form.dataset["webhook"] || undefined);
</script>

<style>
  .waitlist {
    position: relative;
    overflow: hidden;
  }

  .waitlist__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    padding-block: 120px;
    position: relative;
  }

  h2 {
    margin-top: 18px;
    font-size: clamp(40px, 5.6vw, 76px);
    line-height: 0.98;
    letter-spacing: -0.035em;
    font-weight: 300;
  }

  h2 em {
    color: var(--achiote-luz);
  }

  .waitlist__lead {
    margin-top: 20px;
    color: var(--on-noche-muted);
    max-width: 28em;
  }

  .waitlist__orb {
    position: absolute;
    width: 520px;
    height: 520px;
    right: -140px;
    top: -160px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(143 209 155 / 0.18), transparent 65%);
    pointer-events: none;
  }

  .waitlist-form {
    display: grid;
    gap: 14px;
    background: rgb(255 255 255 / 0.04);
    border: 1px solid var(--noche-line);
    padding: 32px;
    border-radius: var(--r-lg);
  }

  label {
    display: grid;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-noche-muted);
  }

  input,
  select {
    width: 100%;
    font: 16px var(--font-sans);
    letter-spacing: 0;
    text-transform: none;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid var(--noche-line);
    background: var(--noche-2);
    color: var(--on-noche);
  }

  input::placeholder {
    color: #6f8473;
  }

  select {
    color-scheme: dark;
  }

  .waitlist-form :global(.btn) {
    margin-top: 6px;
  }

  .waitlist-form :global(.btn:disabled) {
    opacity: 0.6;
    cursor: progress;
  }

  .waitlist-form__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .waitlist-form__hint {
    font-size: 12px;
    color: var(--on-noche-muted);
  }

  .waitlist-form__status {
    font-size: 14px;
    font-weight: 500;
    color: var(--hoja-luz);
  }

  .waitlist-form__status[data-kind="error"] {
    color: var(--achiote-luz);
  }

  .waitlist-form__status[data-kind="info"] {
    color: var(--on-noche-muted);
  }

  @media (max-width: 900px) {
    .waitlist__inner {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-block: 80px;
    }
  }
</style>
