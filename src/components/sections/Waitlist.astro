---
import Button from "@/components/ui/Button.astro";
import type { Herb } from "@/lib/herbs";

type Props = { herbs: Herb[] };
const { herbs } = Astro.props;

const webhookUrl = import.meta.env.PUBLIC_WAITLIST_WEBHOOK_URL ?? "";
---

<section class="waitlist night night-grid" id="lista" aria-labelledby="lista-titulo">
  <div class="waitlist__orb" aria-hidden="true"></div>
  <div class="wrap waitlist__inner">
    <div>
      <div class="eyebrow">Preventa</div>
      <h2 id="lista-titulo">Reserva tu <em>primer frasco</em></h2>
      <p class="waitlist__lead">
        Inscríbete en la lista de espera, elige tu hierba y te avisamos antes que a nadie cuando salga, con precio especial
        de preventa. Reservar no tiene costo ni compromiso.
      </p>
    </div>

    <form class="form" novalidate data-waitlist data-webhook={webhookUrl}>
      <div class="form__field">
        <label for="lista-nombre">Nombre</label>
        <input
          id="lista-nombre"
          name="nombre"
          autocomplete="given-name"
          placeholder="Rosa"
          required
          aria-describedby="lista-nombre-error"
        />
        <p class="form__error" id="lista-nombre-error" data-error-for="nombre" hidden></p>
      </div>
      <div class="form__field">
        <label for="lista-correo">Correo</label>
        <input
          id="lista-correo"
          name="correo"
          type="email"
          autocomplete="email"
          placeholder="rosa@correo.pe"
          required
          aria-describedby="lista-correo-error"
        />
        <p class="form__error" id="lista-correo-error" data-error-for="correo" hidden></p>
      </div>
      <div class="form__field">
        <label for="lista-hierba">Frasco que quieres reservar <span class="form__optional">(opcional)</span></label>
        <select id="lista-hierba" name="hierba">
          <option value="">Todavía no sé</option>
          {herbs.map((herb) => <option value={herb.id}>{herb.name}</option>)}
        </select>
      </div>
      <!-- Trampa anti-spam: invisible para las personas, los bots suelen llenarla. -->
      <label class="form__trap" aria-hidden="true">
        Empresa
        <input name="empresa" tabindex="-1" autocomplete="off" />
      </label>
      <Button type="submit" arrow>Reservar mi frasco</Button>
      {
        !webhookUrl && (
          <p class="form__hint">Versión de muestra: el formulario aún no está conectado a un servicio de correo.</p>
        )
      }
      <p class="form__status" data-status role="status" hidden></p>
    </form>
  </div>
</section>

<script>
  import { mustQs } from "@/scripts/core/dom";
  import { initWaitlist } from "@/scripts/waitlist/initWaitlist";

  const form = mustQs<HTMLFormElement>("[data-waitlist]");
  initWaitlist(form, form.dataset["webhook"] || undefined);
</script>

<style>
  .waitlist {
    position: relative;
    overflow: hidden;
  }

  .waitlist__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    padding-block: 120px;
    position: relative;
  }

  h2 {
    margin-top: 18px;
    font-size: clamp(40px, 5.6vw, 76px);
    line-height: 0.98;
    letter-spacing: -0.035em;
    font-weight: 300;
  }

  h2 em {
    color: var(--achiote-luz);
  }

  .waitlist__lead {
    margin-top: 20px;
    color: var(--on-noche-muted);
    max-width: 28em;
  }

  .waitlist__orb {
    position: absolute;
    width: 520px;
    height: 520px;
    right: -140px;
    top: -160px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(143 209 155 / 0.18), transparent 65%);
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .waitlist__inner {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-block: 80px;
    }
  }
</style>
