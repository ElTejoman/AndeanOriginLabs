---
/**
 * Isotipo de Andean Origin Labs, redibujado sobre reference/Logo_AOL.jpeg (mismas coordenadas, viewBox 720x370):
 * a la izquierda, el Ande con nieve y curvas de nivel; a la derecha, la Amazonía con árboles de copa en capas;
 * encima, una red molecular cuyos nodos en rojo achiote marcan el origen.
 * Los colores salen de --logo-line, --logo-snow, --logo-node, --logo-forest y --logo-paper
 * (el fondo: las líneas de la red que cruzan el bosque se dibujan en ese color, como en el original).
 */
type Props = { height?: number; class?: string };
const { height = 34, class: className } = Astro.props;
const width = Math.round((height * 720) / 370);

