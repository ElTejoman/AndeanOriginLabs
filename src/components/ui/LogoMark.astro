const FOREST_CUTS = "M468 331 L432 358 M468 331 L500 358 M468 331 L468 352 M561 313 L527 358 M561 313 L582 358 M561 313 L677 358";
const TRUNK_CUT = "M561 314 L561 358";
const RED_NODES: ReadonlyArray<Node> = [[364, 24, 9.5], [465, 90, 9], [364, 172, 9], [468, 323, 9.5]];
const GREEN_NODES: ReadonlyArray<Node> = [[398, 126, 8.5], [414, 212, 8.5], [438, 298, 8.5], [561, 305, 8]];
---

<svg
  class:list={["logo-mark", className]}
  width={width}
  height={height}
  viewBox="0 0 720 370"
  aria-hidden="true"
  focusable="false"
>
  <g class="snow">{SNOW.map((d) => <path d={d} />)}</g>

  <g class="line thin">
    {SNOW_LINES.map((d) => <path d={d} />)}
    {CONTOURS.map((d) => <path d={d} />)}
    {NETWORK.map(([x1, y1, x2, y2]) => <line x1={x1} y1={y1} x2={x2} y2={y2} />)}
  </g>

  <g class="line">
    <path d={SILHOUETTE} />
    <path d={RIDGE} />
    {EDGES.map(([x1, y1, x2, y2]) => <line x1={x1} y1={y1} x2={x2} y2={y2} />)}
  </g>

  <g class="forest">
    <path d={GROUND} />
    {UNDERGROWTH.map((d) => <path d={d} />)}
    {TREES.map((tree) => <path class="trunk" d={tree.trunk} />)}
    {TREES.map((tree) => <path d={tree.crown} />)}
  </g>

  <path class="cut" d={FOREST_CUTS} />
  <path class="cut cut--trunk" d={TRUNK_CUT} />

  <g class="node node--red">
    {RED_NODES.map(([cx, cy, r]) => <circle cx={cx} cy={cy} r={r} />)}
  </g>
  <g class="node node--green">
    {GREEN_NODES.map(([cx, cy, r]) => <circle cx={cx} cy={cy} r={r} />)}
  </g>
</svg>

<style>
  .logo-mark {
    flex: none;
    overflow: visible;
  }

  .line {
    fill: none;
    stroke: var(--logo-line);
    stroke-width: 6.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .line.thin {
    stroke-width: 3.6;
  }

  .snow {
    fill: var(--logo-snow);
    opacity: 0.8;
  }

  .forest {
    fill: var(--logo-forest);
  }

  .forest .trunk {
    fill: none;
    stroke: var(--logo-forest);
    stroke-width: 4.5;
    stroke-linecap: round;
  }

  .cut {
    fill: none;
    stroke: var(--logo-paper);
    stroke-width: 3.4;
    stroke-linecap: round;
  }

  .cut--trunk {
    stroke-width: 5;
  }

  .node--red {
    fill: var(--logo-node);
  }

  .node--green {
    fill: var(--logo-forest);
  }
</style>
