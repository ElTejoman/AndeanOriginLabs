---
import ChemicalFormula from "@/components/ui/ChemicalFormula.astro";
import { SITE } from "@/data/site";
import type { Herb } from "@/lib/herbs";

/**
 * El frasco del producto, dibujado solo con CSS. Escala con `width`: todo se mide en em.
 * `mini` es la versión simplificada de las tarjetas de la colección.
 */
type Props = {
  herb: Pick<Herb, "name" | "scientificName" | "molecule" | "lot">;
  width?: number;
  variant?: "full" | "mini";
  class?: string;
};
const { herb, width = 200, variant = "full", class: className } = Astro.props;
---

<span class:list={["jar", `jar--${variant}`, className]} style={`--jar-width: ${width}px`} aria-hidden="true">
  <span class="jar__lid"></span>
  <span class="jar__neck"></span>
  <span class="jar__body">
    <span class="jar__label">
      {
        variant === "mini" ? (
          <>
            <span class="jar__name">{herb.name}</span>
            <span class="jar__band">En polvo</span>
          </>
        ) : (
          <>
            <span class="jar__brand">
              <i></i>
              {SITE.name}
            </span>
            <span class="jar__name">{herb.name}</span>
            <span class="jar__sci">{herb.scientificName}</span>
            <span class="jar__band">Extracto en polvo</span>
            <span class="jar__formula">
              <ChemicalFormula formula={herb.molecule.formula} />
            </span>
            <span class="jar__lot">{herb.lot.origin} · Lote 001</span>
          </>
        )
      }
    </span>
  </span>
</span>

<style>
  .jar {
    display: block;
    flex: none;
    position: relative;
    width: var(--jar-width);
    max-width: 100%;
    font-size: calc(var(--jar-width) / 15);
  }

  .jar > span,
  .jar__label > span {
    display: block;
  }

  .jar__lid {
    height: 2.5em;
    width: 82%;
    margin: 0 auto;
    background: var(--jar-lid);
    border-radius: 0.55em 0.55em 0.2em 0.2em;
    background-image:
      linear-gradient(90deg, rgb(0 0 0 / 0.25), rgb(255 255 255 / 0.12) 30%, rgb(0 0 0 / 0.05) 60%, rgb(0 0 0 / 0.3)),
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.06) 0 0.2em, transparent 0.2em 0.5em);
  }

  .jar__neck {
    height: 0.5em;
    width: 76%;
    margin: 0 auto;
    background: var(--jar-shade);
  }

  .jar__body {
    background: var(--jar-body);
    border-radius: 1.2em 1.2em 1em 1em;
    padding: 1.7em 0 1.5em;
    background-image: linear-gradient(
      90deg,
      rgb(0 0 0 / 0.35),
      rgb(255 255 255 / 0.1) 22%,
      rgb(255 255 255 / 0) 45%,
      rgb(0 0 0 / 0.2) 80%,
      rgb(0 0 0 / 0.4)
    );
    box-shadow: 0 2em 3em -1.6em rgb(10 20 12 / 0.55);
  }

  .jar__label {
    display: block;
    background: var(--jar-label);
    color: var(--jar-ink);
    padding: 1em 0.9em 0.9em;
    text-align: center;
    line-height: 1.25;
  }

  .jar__label > .jar__brand {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    font-family: var(--font-mono);
    font-size: 0.55em;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--jar-muted);
  }

  .jar__brand i {
    display: block;
    width: 0.9em;
    height: 0.9em;
    border-radius: var(--leaf);
    background: var(--jar-band);
  }

  .jar__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.8em;
    line-height: 1.02;
    margin-top: 0.35em;
    letter-spacing: -0.02em;
  }

  .jar__sci {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: 0.8em;
    color: var(--jar-muted);
    margin-top: 0.2em;
  }

  .jar__band {
    background: var(--jar-band);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.55em;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.6em 0;
    margin: 0.9em -1.65em 0;
  }

  .jar__formula {
    font-family: var(--font-mono);
    font-size: 0.62em;
    margin-top: 0.8em;
    color: var(--jar-ink);
  }

  .jar__lot {
    font-family: var(--font-mono);
    font-size: 0.5em;
    color: var(--jar-muted);
    margin-top: 0.5em;
    letter-spacing: 0.06em;
  }

  /* versión mini (tarjetas) */
  .jar--mini .jar__body {
    padding: 1em 0 0.9em;
  }

  .jar--mini .jar__label {
    padding: 0.7em 0.3em;
  }

  .jar--mini .jar__name {
    font-size: 1.45em;
    margin-top: 0;
  }

  .jar--mini .jar__band {
    margin: 0.6em -0.3em 0;
    font-size: 0.55em;
    padding: 0.45em 0;
  }
</style>
