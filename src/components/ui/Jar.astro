---
import { SITE } from "@/data/site";
import { formulaNumber, type Formula } from "@/lib/formulas";

/** El frasco de una fórmula, dibujado solo con CSS. Escala con `width`: todo se mide en em. */
type Props = {
  formula: Pick<Formula, "name" | "order" | "herbs">;
  width?: number;
  class?: string;
};
const { formula, width = 200, class: className } = Astro.props;
---

<span class:list={["jar", className]} style={`--jar-width: ${width}px`} aria-hidden="true">
  <span class="jar__lid"></span>
  <span class="jar__neck"></span>
  <span class="jar__body">
    <span class="jar__label">
      <span class="jar__brand">
        <i></i>
        {SITE.name}
      </span>
      <span class="jar__name">{formula.name}</span>
      <span class="jar__herbs">{formula.herbs.map((herb) => herb.name).join(" · ")}</span>
      <span class="jar__band">Extracto concentrado</span>
      <span class="jar__lot">{formulaNumber(formula)} · Hecho en Perú</span>
    </span>
  </span>
</span>

<style>
  .jar {
    display: block;
    flex: none;
    position: relative;
    width: var(--jar-width);
    max-width: 100%;
    font-size: calc(var(--jar-width) / 15);
  }

  .jar > span,
  .jar__label > span {
    display: block;
  }

  .jar__lid {
    height: 2.5em;
    width: 82%;
    margin: 0 auto;
    background: var(--jar-lid);
    border-radius: 0.55em 0.55em 0.2em 0.2em;
    background-image:
      linear-gradient(90deg, rgb(0 0 0 / 0.25), rgb(255 255 255 / 0.12) 30%, rgb(0 0 0 / 0.05) 60%, rgb(0 0 0 / 0.3)),
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.06) 0 0.2em, transparent 0.2em 0.5em);
  }

  .jar__neck {
    height: 0.5em;
    width: 76%;
    margin: 0 auto;
    background: var(--jar-shade);
  }

  .jar__body {
    background: var(--jar-body);
    border-radius: 1.2em 1.2em 1em 1em;
    padding: 1.7em 0 1.5em;
    background-image: linear-gradient(
      90deg,
      rgb(0 0 0 / 0.35),
      rgb(255 255 255 / 0.1) 22%,
      rgb(255 255 255 / 0) 45%,
      rgb(0 0 0 / 0.2) 80%,
      rgb(0 0 0 / 0.4)
    );
    box-shadow: 0 2em 3em -1.6em rgb(10 20 12 / 0.55);
  }

  .jar__label {
    display: block;
    background: var(--jar-label);
    color: var(--jar-ink);
    padding: 1em 0.9em 0.9em;
    text-align: center;
    line-height: 1.25;
  }

  .jar__label > .jar__brand {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    font-family: var(--font-mono);
    font-size: 0.55em;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--jar-muted);
  }

  .jar__brand i {
    display: block;
    width: 0.9em;
    height: 0.9em;
    border-radius: var(--leaf);
    background: var(--jar-band);
  }

  .jar__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.8em;
    line-height: 1.02;
    margin-top: 0.35em;
    letter-spacing: -0.02em;
  }

  .jar__herbs {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: 0.72em;
    color: var(--jar-muted);
    margin-top: 0.3em;
  }

  .jar__band {
    background: var(--jar-band);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.55em;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.6em 0;
    margin: 0.9em -1.65em 0;
  }

  .jar__lot {
    font-family: var(--font-mono);
    font-size: 0.5em;
    color: var(--jar-muted);
    margin-top: 0.8em;
    letter-spacing: 0.06em;
  }
</style>
