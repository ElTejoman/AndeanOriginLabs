---
import LogoMark from "@/components/ui/LogoMark.astro";
import { SITE } from "@/data/site";

/**
 * Logotipo completo: isotipo + "ANDEAN ORIGIN / L A B S".
 * `tone="on-dark"` adapta los colores para las bandas nocturnas (header y footer).
 */
type Props = {
  href?: string;
  markHeight?: number;
  tone?: "on-light" | "on-dark";
  label?: string;
};
const { href = "#inicio", markHeight = 34, tone = "on-dark", label = `${SITE.name}, inicio` } = Astro.props;
---

<a class:list={["logo", `logo--${tone}`]} href={href} aria-label={label}>
  <LogoMark height={markHeight} />
  <span class="wordmark" aria-hidden="true">
    <span class="wordmark__name">Andean Origin</span>
    <span class="wordmark__labs">Labs</span>
  </span>
</a>

<style>
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--logo-text);
  }

  .logo--on-light {
    --logo-text: var(--verde-selva);
  }

  .logo--on-dark {
    --logo-text: var(--on-noche);
    --logo-line: var(--on-noche);
    --logo-snow: #9fb6c4;
    --logo-node: var(--achiote-luz);
    --logo-forest: var(--hoja-luz);
  }

  .wordmark {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
  }

  .wordmark__name {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .wordmark__labs {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.6em;
    margin-right: -0.6em;
    text-transform: uppercase;
    margin-top: 6px;
    opacity: 0.85;
  }

  @media (max-width: 480px) {
    .logo {
      gap: 8px;
    }

    .logo :global(.logo-mark) {
      width: auto;
      height: 26px;
    }

    .wordmark__name {
      font-size: 14px;
    }

    .wordmark__labs {
      font-size: 8px;
    }
  }
</style>
