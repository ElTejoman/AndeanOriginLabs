---
import type { HTMLAttributes } from "astro/types";

/**
 * Botón con forma de píldora. Con `href` se dibuja como enlace; sin él, como <button>.
 * Variantes: primary (achiote), light y line (sobre bandas nocturnas), green (selva).
 */
type Props = (HTMLAttributes<"a"> & HTMLAttributes<"button">) & {
  variant?: "primary" | "light" | "line" | "green";
  size?: "md" | "sm";
  arrow?: boolean;
};

const { variant = "primary", size = "md", arrow = false, href, class: className, type = "button", ...rest } = Astro.props;
const Tag = href ? "a" : "button";
const classes = ["btn", `btn--${variant}`, `btn--${size}`, className];
---

{
  Tag === "a" ? (
    <a class:list={classes} href={href} {...rest}>
      <slot />
      {arrow && <span class="btn__arrow" aria-hidden="true">→</span>}
    </a>
  ) : (
    <button class:list={classes} type={type} {...rest}>
      <slot />
      {arrow && <span class="btn__arrow" aria-hidden="true">→</span>}
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font: 600 15px/1 var(--font-sans);
    padding: 15px 24px;
    border-radius: var(--r-pill);
    text-decoration: none;
    border: 1px solid transparent;
    cursor: pointer;
    white-space: nowrap;
    transition:
      transform 0.25s var(--ease),
      background 0.25s,
      color 0.25s;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn__arrow {
    transition: transform 0.25s var(--ease);
  }

  .btn:hover .btn__arrow {
    transform: translateX(4px);
  }

  .btn--sm {
    padding: 10px 18px;
    font-size: 14px;
  }

  .btn--primary {
    background: var(--rojo-achiote);
    color: #fff;
  }

  .btn--light {
    background: var(--on-noche);
    color: var(--noche);
  }

  .btn--line {
    border-color: var(--noche-line);
    color: var(--on-noche);
    background: rgb(255 255 255 / 0.03);
  }

  .btn--green {
    background: var(--verde-selva);
    color: var(--on-brand);
  }
</style>
