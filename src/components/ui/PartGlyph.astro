  planta: {
    line:
      "M24 45 C23 35 24 22 27 6 M23.6 38 A6.2 6.2 0 0 1 13.6 35 A6.2 6.2 0 0 1 23.6 38Z M23.7 33 A6.2 6.2 0 0 0 33.7 30 A6.2 6.2 0 0 0 23.7 33Z M23.8 28 A6.2 6.2 0 0 1 13.8 25 A6.2 6.2 0 0 1 23.8 28Z M24.3 23 A6.2 6.2 0 0 0 34.3 20 A6.2 6.2 0 0 0 24.3 23Z M25 18 A6.2 6.2 0 0 1 15.5 14.5 A6.2 6.2 0 0 1 25 18Z M26 12 A6.2 6.2 0 0 0 35 8.5 A6.2 6.2 0 0 0 26 12Z",
