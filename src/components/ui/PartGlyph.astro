  "hojas-opuestas": {
    line:
      "M24 46 V8 M24 34 A8.5 8.5 0 0 1 11 29 A8.5 8.5 0 0 1 24 34Z M24 34 A8.5 8.5 0 0 0 37 29 A8.5 8.5 0 0 0 24 34Z M24 24 A7.5 7.5 0 0 1 13 19.5 A7.5 7.5 0 0 1 24 24Z M24 24 A7.5 7.5 0 0 0 35 19.5 A7.5 7.5 0 0 0 24 24Z M24 15 A5.5 5.5 0 0 1 16 11.5 A5.5 5.5 0 0 1 24 15Z M24 15 A5.5 5.5 0 0 0 32 11.5 A5.5 5.5 0 0 0 24 15Z",
