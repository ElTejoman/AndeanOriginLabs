  ramillete: {
    line:
      "M24 46 V16 M24 31 C21 27 18 25 16 22 M24 27 C27 23 30 21 32 18 M24 40 A4.2 4.2 0 0 1 17.5 37 A4.2 4.2 0 0 1 24 40Z M24 40 A4.2 4.2 0 0 0 30.5 37 A4.2 4.2 0 0 0 24 40Z M24 35 A3.6 3.6 0 0 1 18.5 32.5 A3.6 3.6 0 0 1 24 35Z M24 35 A3.6 3.6 0 0 0 29.5 32.5 A3.6 3.6 0 0 0 24 35Z",
