  },
};

type Props = { name: PartGlyph; size?: number };
const { name, size = 56 } = Astro.props;
const glyph = GLYPHS[name];
---

<svg class="glyph" width={size} height={size} viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  <path class="line" d={glyph.line} />
  <path class="accent" d={glyph.accent} />
</svg>

<style>
  .glyph {
    display: block;
    overflow: visible;
  }

  .line {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .accent {
    fill: var(--glyph-accent, var(--rojo-achiote));
    transition: fill 0.3s;
  }
</style>
