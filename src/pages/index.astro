---
import SiteFooter from "@/components/layout/SiteFooter.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import Collection from "@/components/sections/Collection.astro";
import Culture from "@/components/sections/Culture.astro";
import EvidenceGuide from "@/components/sections/EvidenceGuide.astro";
import Faq from "@/components/sections/Faq.astro";
import Formulas from "@/components/sections/Formulas.astro";
import HerbMarquee from "@/components/sections/HerbMarquee.astro";
import Hero from "@/components/sections/Hero.astro";
import Origin from "@/components/sections/Origin.astro";
import PartnerBanner from "@/components/sections/PartnerBanner.astro";
import Partners from "@/components/sections/Partners.astro";
import Process from "@/components/sections/Process.astro";
import ProductBento from "@/components/sections/ProductBento.astro";
import TwoKnowledges from "@/components/sections/TwoKnowledges.astro";
import Waitlist from "@/components/sections/Waitlist.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getFormulas } from "@/lib/formulas";
import { getHerbs } from "@/lib/herbs";

const herbs = await getHerbs();
const formulas = await getFormulas(herbs);
---

<BaseLayout>
  <SiteHeader />
  <main id="inicio">
    <Hero herbs={herbs} formulas={formulas} />
    <HerbMarquee herbs={herbs} />
    <TwoKnowledges />
    <Formulas formulas={formulas} herbs={herbs} />
    <ProductBento formulas={formulas} />
    <PartnerBanner />
    <EvidenceGuide />
    <Collection herbs={herbs} formulas={formulas} />
    <Origin herbs={herbs} />
    <Process />
    <Partners formulas={formulas} />
    <Culture />
    <Faq />
    <Waitlist formulas={formulas} />
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  import { initActions } from "@/scripts/core/actions";
  import { markMotionReady } from "@/scripts/motion/motion";
  import { initScrollReveal } from "@/scripts/motion/reveal";

  initActions();
  initScrollReveal();
  markMotionReady();
</script>
